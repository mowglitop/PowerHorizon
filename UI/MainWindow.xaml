<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerHorizon" Width="1100" Height="740" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F3F5F9" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="0,4,12,12"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="0,4,12,12"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="16,7"/><Setter Property="Margin" Value="0,0,10,0"/></Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20">
      <TextBlock Text="PowerHorizon" FontSize="30" FontWeight="SemiBold" Foreground="#173454"/>
      <TextBlock Text="Administration Horizon • Connexion et inventaire VDI" Foreground="#53657B"/>
    </StackPanel>
    <Border Grid.Row="1" Background="White" Padding="18" CornerRadius="8" Margin="0,0,0,16">
      <StackPanel>
        <ComboBox x:Name="Environment" DisplayMemberPath="Name" Margin="0,0,0,14" Padding="6"/>
        <Grid x:Name="CredentialsPanel">
          <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Connection Server (FQDN)"/><TextBox x:Name="Server"/></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="Domaine AD"/><TextBox x:Name="Domain"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Utilisateur (sans domaine)"/><TextBox x:Name="Username"/></StackPanel>
          <StackPanel Grid.Column="3"><TextBlock Text="Mot de passe"/><PasswordBox x:Name="Password"/></StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="Connect" Content="Se connecter" Background="#173454" Foreground="White"/>
          <Button x:Name="Disconnect" Content="Se déconnecter" IsEnabled="False"/>
          <TextBlock x:Name="Identity" Text="Non connecté" VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="2">
      <TextBlock Text="Inventaire des VDI" FontSize="20" FontWeight="SemiBold"/>
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Hostname commence par (facultatif)"/><TextBox x:Name="MachineFilter" ToolTip="Exemple : VD57 retrouve VD57039 et VD57040. Aucun * nécessaire."/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="Pool exact (facultatif)"/><TextBox x:Name="PoolFilter"/></StackPanel>
        <Button Grid.Column="2" x:Name="Search" Content="Rechercher" IsEnabled="False" VerticalAlignment="Center"/>
      </Grid>
    </StackPanel>
    <DataGrid Grid.Row="3" x:Name="Machines" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
              SelectionMode="Extended" Background="White" BorderBrush="#D9E0E9" GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="*"/>
        <DataGridTextColumn Header="DNS" Binding="{Binding DNS}" Width="1.5*"/>
        <DataGridTextColumn Header="Pool" Binding="{Binding Pool}" Width="*"/>
        <DataGridTextColumn Header="État" Binding="{Binding State}" Width="*"/>
        <DataGridTextColumn Header="Utilisateur affecté" Binding="{Binding AssignedUser}" Width="1.3*"/>
      </DataGrid.Columns>
    </DataGrid>
    <Expander Grid.Row="4" Header="Collecte de diagnostics par hostname" Margin="0,12,0,0">
      <StackPanel Margin="8">
        <TextBlock Text="WinRM • Compte Windows courant • Indépendant de la connexion Horizon" Foreground="#53657B"/>
        <DockPanel Margin="0,6,0,0">
          <Button x:Name="Collect" Content="Collecter en ZIP" DockPanel.Dock="Right" VerticalAlignment="Center"/>
          <TextBox x:Name="DiagnosticHost" ToolTip="Hostname ou FQDN du VDI" MinWidth="180"/>
        </DockPanel>
        <WrapPanel x:Name="DiagnosticOptions">
          <CheckBox x:Name="DiagSystem" Content="Système" IsChecked="True" Margin="0,0,16,8"/>
          <CheckBox x:Name="DiagNetwork" Content="Réseau" IsChecked="True" Margin="0,0,16,8"/>
          <CheckBox x:Name="DiagEvents" Content="Journaux Windows" IsChecked="True" Margin="0,0,16,8"/>
          <CheckBox x:Name="DiagGroupPolicy" Content="GPO machine" Margin="0,0,16,8"/>
          <CheckBox x:Name="DiagAgentLogs" Content="Logs agents (configurés)" Margin="0,0,16,8"/>
        </WrapPanel>
        <TextBox x:Name="DiagnosticResult" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="80" VerticalScrollBarVisibility="Auto"
                 Text="Archives enregistrées dans Exports. Sélectionne un VDI dans le tableau pour préremplir le hostname."/>
      </StackPanel>
    </Expander>
    <StackPanel Grid.Row="5" Margin="0,12,0,0">
      <ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Collapsed"/>
      <TextBlock x:Name="Status" Text="Renseigne le serveur et ton compte AD pour commencer." TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
  </Grid>
</Window>
